@HostAddress = http://localhost:5268
@json = application/json
@jwtToken = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..3J5mjBgAt8Kuc4dyQ5uCUsmqsJIQEeq1hJnOptwSlBM

###############################################
# HOTELS ENDPOINTS
###############################################

### 1. Get All Hotels
GET {{HostAddress}}/api/hotels
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 2. Get Hotel By ID
GET {{HostAddress}}/api/hotels/5
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 3. Create New Hotel (Linked to CountryId: 1)
POST {{HostAddress}}/api/hotels
Content-Type: {{json}}
Authorization: {{jwtToken}}

{
  "name": "Jewels Runaway Bay",
  "address": "Ocho Rios, Jamaica",
  "rating": 4.6,
  "countryId": 3
}

###

### 4. Update Hotel
PUT {{HostAddress}}/api/hotels/4
Content-Type: {{json}}
Authorization: {{jwtToken}}

{
  "id": 4,
  "name": "Tarasivska Resort",
  "address": "Tarasivska str",
  "rating": 4.9,
  "countryId": 1
}

###

### 5. Delete Hotel By ID
DELETE {{HostAddress}}/api/hotels/1
Authorization: {{jwtToken}}

###

