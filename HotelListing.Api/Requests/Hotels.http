@HostAddress = http://localhost:5268
@json = application/json
@jwtToken = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..lDyXj77iUBRy9t67UBNbgQbTKdS0QXMw4-1d3z8SEaU

###############################################
# HOTELS ENDPOINTS
###############################################

### 1. Get All Hotels (Default Pagination: page 1, size 10)
GET {{HostAddress}}/api/hotels
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 2. Get All Hotels (Custom Pagination: page 2, size 5)
GET {{HostAddress}}/api/hotels?pageNumber=2&pageSize=5
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 3. Get Filtered & Sorted Hotels (CountryId=2, MinRating=4.5, SortBy=rating desc)
GET {{HostAddress}}/api/hotels?CountryId=2&MinRating=4.5&SortBy=rating&SortDescending=true&pageNumber=1&pageSize=10
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 4. Get Hotel By ID
GET {{HostAddress}}/api/hotels/5
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 4. Create New Hotel (Linked to CountryId: 2 - Jamaica)
POST {{HostAddress}}/api/hotels
Content-Type: {{json}}
Authorization: {{jwtToken}}

{
  "name": "Jewels Runaway Bay",
  "address": "Ocho Rios, Jamaica",
  "rating": 4.6,
  "countryId": 2
}

###

### 5. Update Hotel
PUT {{HostAddress}}/api/hotels/4
Content-Type: {{json}}
Authorization: {{jwtToken}}

{
  "id": 4,
  "name": "Tarasivska Resort",
  "address": "Tarasivska str",
  "rating": 4.9,
  "countryId": 1
}

###

### 6. Delete Hotel By ID
DELETE {{HostAddress}}/api/hotels/1
Authorization: {{jwtToken}}

###
