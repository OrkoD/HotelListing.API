@HostAddress = http://localhost:5268
@json = application/json
@jwtToken = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..lDyXj77iUBRy9t67UBNbgQbTKdS0QXMw4-1d3z8SEaU

###############################################
# HOTEL BOOKINGS ENDPOINTS (/api/hotels/{hotelId}/bookings)
###############################################

### 1. Create a New Booking for Hotel (Requires JWT Token)
POST {{HostAddress}}/api/hotels/5/bookings
Content-Type: {{json}}
Authorization: {{jwtToken}}

{
  "hotelId": 5,
  "checkIn": "2026-09-15",
  "checkOut": "2026-09-18",
  "guests": 2
}

###

### 2. Get User Bookings for Hotel (Default Pagination)
GET {{HostAddress}}/api/hotels/5/bookings
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 3. Get User Bookings for Hotel (Custom Pagination: page 1, size 5)
GET {{HostAddress}}/api/hotels/5/bookings?pageNumber=1&pageSize=5
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 4. Get User Bookings with Filters & Sorting (Status=Pending, SortBy=checkin)
GET {{HostAddress}}/api/hotels/5/bookings?Status=Pending&SortBy=checkin&SortDescending=false&pageNumber=1&pageSize=10
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 5. Get All Bookings for Hotel (Admin Only - Default Pagination)
GET {{HostAddress}}/api/hotels/5/bookings/admin
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 6. Get All Bookings for Hotel (Admin Only - Custom Pagination: page 1, size 5)
GET {{HostAddress}}/api/hotels/5/bookings/admin?pageNumber=1&pageSize=5
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 7. Get All Bookings for Hotel (Admin Only - Filtered by Status, Price, Guests)
GET {{HostAddress}}/api/hotels/5/bookings/admin?Status=Confirmed&MinGuests=2&SortBy=price&SortDescending=true&pageNumber=1&pageSize=10
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 8. Update Booking
PUT {{HostAddress}}/api/hotels/5/bookings/8
Content-Type: {{json}}
Authorization: {{jwtToken}}

{
  "checkIn": "2026-09-16",
  "checkOut": "2026-09-19",
  "guests": 3
}

###

### 9. Cancel Booking (User)
PUT {{HostAddress}}/api/hotels/5/bookings/8/cancel
Authorization: {{jwtToken}}

###

### 10. Admin Cancel Booking
PUT {{HostAddress}}/api/hotels/5/bookings/8/admin/cancel
Authorization: {{jwtToken}}

###

### 11. Admin Confirm Booking
PUT {{HostAddress}}/api/hotels/5/bookings/8/admin/confirm
Authorization: {{jwtToken}}

###
