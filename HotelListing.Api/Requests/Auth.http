@HostAddress = http://localhost:5268
@json = application/json
@bearerToken = YOUR_ACCESS_TOKEN_HERE

###############################################
# CUSTOM AUTH CONTROLLER ENDPOINTS (/api/auth)
###############################################

### 1. Register User (Success)
POST {{HostAddress}}/api/auth/register
Content-Type: {{json}}

{
  "email": "admin@example.com",
  "password": "Password123!",
  "firstName": "Admin",
  "lastName": "Administrator",
  "role": "Admin"
}

###

### 2. Register User (Validation Error - Short Password)
POST {{HostAddress}}/api/auth/register
Content-Type: {{json}}

{
  "email": "jane.doe@example.com",
  "password": "short",
  "firstName": "Jane",
  "lastName": "Doe"
}

###

### 3. Login User (Success)
POST {{HostAddress}}/api/auth/login
Content-Type: {{json}}

{
  "email": "admin@example.com",
  "password": "Password123!"
}

###

### 4. Login User (Invalid Credentials)
POST {{HostAddress}}/api/auth/login
Content-Type: {{json}}

{
  "email": "john.doe@example.com",
  "password": "WrongPassword!"
}

###


###############################################
# BUILT-IN IDENTITY ENDPOINTS (/api/default-auth)
###############################################

### 1. Default Register
POST {{HostAddress}}/api/default-auth/register
Content-Type: {{json}}

{
  "email": "defaultuser@example.com",
  "password": "Password123!"
}

###

### 2. Default Login (Get Bearer & Refresh Token)
POST {{HostAddress}}/api/default-auth/login?useCookies=false
Content-Type: {{json}}

{
  "email": "defaultuser@example.com",
  "password": "Password123!"
}

###

### 3. Default Refresh Token
POST {{HostAddress}}/api/default-auth/refresh
Content-Type: {{json}}

{
  "refreshToken": "YOUR_REFRESH_TOKEN_HERE"
}

###

### 4. Default Get User Profile Info (Requires Auth)
GET {{HostAddress}}/api/default-auth/manage/info
Accept: {{json}}
Authorization: Bearer {{bearerToken}}

###

### 5. Default Update User Email / Password (Requires Auth)
POST {{HostAddress}}/api/default-auth/manage/info
Content-Type: {{json}}
Authorization: Bearer {{bearerToken}}

{
  "newEmail": "newuser@example.com",
  "newPassword": "NewPassword123!",
  "oldPassword": "Password123!"
}

###

### 6. Default Forgot Password
POST {{HostAddress}}/api/default-auth/forgotPassword
Content-Type: {{json}}

{
  "email": "defaultuser@example.com"
}

###

### 7. Default Resend Confirmation Email
POST {{HostAddress}}/api/default-auth/resendConfirmationEmail
Content-Type: {{json}}

{
  "email": "defaultuser@example.com"
}

###

