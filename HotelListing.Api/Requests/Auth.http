@HostAddress = http://localhost:5268
@json = application/json

###############################################
# CUSTOM AUTH CONTROLLER ENDPOINTS (/api/auth)
###############################################

### 1. Register User (Success)
POST {{HostAddress}}/api/auth/register
Content-Type: {{json}}

{
  "email": "hotel_admin@example.com",
  "password": "Password123!",
  "firstName": "HotelAdmin",
  "lastName": "Administrator",
  "role": "Hotel Admin"
}

###

### 2. Register User (Validation Error - Short Password)
POST {{HostAddress}}/api/auth/register
Content-Type: {{json}}

{
  "email": "jane.doe@example.com",
  "password": "short",
  "firstName": "Jane",
  "lastName": "Doe"
}

###

### 3. Login User (Success - Returns JWT Token)
POST {{HostAddress}}/api/auth/login
Content-Type: {{json}}

{
  "email": "admin@example.com",
  "password": "Password123!"
}

###

### 4. Login User (Invalid Credentials)
POST {{HostAddress}}/api/auth/login
Content-Type: {{json}}

{
  "email": "john.doe@example.com",
  "password": "WrongPassword!"
}

###
