@HotelListing.Api_HostAddress = http://localhost:5268
@json = application/json

###############################################
# HOTELS ENDPOINTS
###############################################

### 1. Get All Hotels
GET {{HotelListing.Api_HostAddress}}/api/hotels
Accept: {{json}}

###

### 2. Get Hotel By ID
GET {{HotelListing.Api_HostAddress}}/api/hotels/5
Accept: {{json}}

###

### 3. Create New Hotel (Linked to CountryId: 1)
POST {{HotelListing.Api_HostAddress}}/api/hotels
Content-Type: {{json}}

{
  "name": "Grand Palladium Resort",
  "address": "Lucea, Hanover",
  "rating": 4.6,
  "countryId": 1
}

###

### 4. Update Hotel
PUT {{HotelListing.Api_HostAddress}}/api/hotels/4
Content-Type: {{json}}

{
  "id": 4,
  "name": "Tarasivska Resort",
  "address": "Tarasivska str",
  "rating": 4.9,
  "countryId": 1
}

###

### 5. Delete Hotel By ID
DELETE {{HotelListing.Api_HostAddress}}/api/hotels/1

###


###############################################
# COUNTRIES ENDPOINTS
###############################################

### 1. Get All Countries
GET {{HotelListing.Api_HostAddress}}/api/countries
Accept: {{json}}

###

### 2. Get Country By ID
GET {{HotelListing.Api_HostAddress}}/api/countries/1
Accept: {{json}}

###

### 3. Create New Country
POST {{HotelListing.Api_HostAddress}}/api/countries
Content-Type: {{json}}

{
  "name": "Bahamas",
  "shortName": "BS"
}

###

### 4. Update Country
PUT {{HotelListing.Api_HostAddress}}/api/countries/1
Content-Type: {{json}}

{
  "id": 1,
  "name": "Jamaica",
  "shortName": "JM"
}

###

### 5. Delete Country By ID
DELETE {{HotelListing.Api_HostAddress}}/api/countries/1

###


###############################################
# AUTH CONTROLLER ENDPOINTS (/api/auth)
###############################################

### 1. Register User (Success)
POST {{HotelListing.Api_HostAddress}}/api/auth/register
Content-Type: {{json}}

{
  "email": "john.doe@example.com",
  "password": "Password123!",
  "firstName": "John",
  "lastName": "Doe"
}

###

### 2. Register User (Validation Error - Short Password)
POST {{HotelListing.Api_HostAddress}}/api/auth/register
Content-Type: {{json}}

{
  "email": "jane.doe@example.com",
  "password": "short",
  "firstName": "Jane",
  "lastName": "Doe"
}

###

### 3. Login User (Success)
POST {{HotelListing.Api_HostAddress}}/api/auth/login
Content-Type: {{json}}

{
  "email": "john.doe@example.com",
  "password": "Password123!"
}

###

### 4. Login User (Invalid Credentials)
POST {{HotelListing.Api_HostAddress}}/api/auth/login
Content-Type: {{json}}

{
  "email": "john.doe@example.com",
  "password": "WrongPassword!"
}

###


###############################################
# BUILT-IN IDENTITY ENDPOINTS (/api/default-auth)
###############################################

@bearerToken = YOUR_ACCESS_TOKEN_HERE

### 1. Default Register
POST {{HotelListing.Api_HostAddress}}/api/default-auth/register
Content-Type: {{json}}

{
  "email": "defaultuser@example.com",
  "password": "Password123!"
}

###

### 2. Default Login (Get Bearer & Refresh Token)
POST {{HotelListing.Api_HostAddress}}/api/default-auth/login?useCookies=false
Content-Type: {{json}}

{
  "email": "defaultuser@example.com",
  "password": "Password123!"
}

###

### 3. Default Refresh Token
POST {{HotelListing.Api_HostAddress}}/api/default-auth/refresh
Content-Type: {{json}}

{
  "refreshToken": "YOUR_REFRESH_TOKEN_HERE"
}

###

### 4. Default Get User Profile Info (Requires Auth)
GET {{HotelListing.Api_HostAddress}}/api/default-auth/manage/info
Accept: {{json}}
Authorization: Bearer {{bearerToken}}

###

### 5. Default Update User Email / Password (Requires Auth)
POST {{HotelListing.Api_HostAddress}}/api/default-auth/manage/info
Content-Type: {{json}}
Authorization: Bearer {{bearerToken}}

{
  "newEmail": "newuser@example.com",
  "newPassword": "NewPassword123!",
  "oldPassword": "Password123!"
}

###

### 6. Default Forgot Password
POST {{HotelListing.Api_HostAddress}}/api/default-auth/forgotPassword
Content-Type: {{json}}

{
  "email": "defaultuser@example.com"
}

###

### 7. Default Resend Confirmation Email
POST {{HotelListing.Api_HostAddress}}/api/default-auth/resendConfirmationEmail
Content-Type: {{json}}

{
  "email": "defaultuser@example.com"
}

###
