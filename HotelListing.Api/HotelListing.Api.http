@HotelListing.Api_HostAddress = http://localhost:5268
@json = application/json
@apiKey = AnP3NdcK49FsdDat45N2l4=
@jwtToken = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..E9WTo0M1dfy0ZfYurqfo-rf13JeuK7DcX5o2yDdH4wA

###############################################
# HOTELS ENDPOINTS
###############################################

### 1. Get All Hotels
GET {{HotelListing.Api_HostAddress}}/api/hotels
Accept: {{json}}

###

### 2. Get Hotel By ID
GET {{HotelListing.Api_HostAddress}}/api/hotels/5
Accept: {{json}}

###

### 3. Create New Hotel (Linked to CountryId: 1)
POST {{HotelListing.Api_HostAddress}}/api/hotels
Content-Type: {{json}}

{
  "name": "Grand Palladium Resort",
  "address": "Lucea, Hanover",
  "rating": 4.6,
  "countryId": 1
}

###

### 4. Update Hotel
PUT {{HotelListing.Api_HostAddress}}/api/hotels/4
Content-Type: {{json}}

{
  "id": 4,
  "name": "Tarasivska Resort",
  "address": "Tarasivska str",
  "rating": 4.9,
  "countryId": 1
}

###

### 5. Delete Hotel By ID
DELETE {{HotelListing.Api_HostAddress}}/api/hotels/1

###


###############################################
# COUNTRIES ENDPOINTS
###############################################

### 1. Get All Countries
GET {{HotelListing.Api_HostAddress}}/api/countries
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 2. Get Country By ID
GET {{HotelListing.Api_HostAddress}}/api/countries/1
Accept: {{json}}
Authorization: {{jwtToken}}

###

### 3. Create New Country
POST {{HotelListing.Api_HostAddress}}/api/countries
Content-Type: {{json}}
Authorization: {{jwtToken}}

{
  "name": "United Kingdom",
  "shortName": "UK"
}

###

### 4. Update Country
PUT {{HotelListing.Api_HostAddress}}/api/countries/1
Content-Type: {{json}}

{
  "id": 1,
  "name": "Jamaica",
  "shortName": "JM"
}

###

### 5. Delete Country By ID
DELETE {{HotelListing.Api_HostAddress}}/api/countries/1

###


###############################################
# AUTH CONTROLLER ENDPOINTS (/api/auth)
###############################################

### 1. Register User (Success)
POST {{HotelListing.Api_HostAddress}}/api/auth/register
Content-Type: {{json}}

{
  "email": "admin@example.com",
  "password": "Password123!",
  "firstName": "Admin",
  "lastName": "Administrator",
  "role": "Admin"
}

###

### 2. Register User (Validation Error - Short Password)
POST {{HotelListing.Api_HostAddress}}/api/auth/register
Content-Type: {{json}}

{
  "email": "jane.doe@example.com",
  "password": "short",
  "firstName": "Jane",
  "lastName": "Doe"
}

###

### 3. Login User (Success)
POST {{HotelListing.Api_HostAddress}}/api/auth/login
Content-Type: {{json}}

{
  "email": "admin@example.com",
  "password": "Password123!"
}

###

### 4. Login User (Invalid Credentials)
POST {{HotelListing.Api_HostAddress}}/api/auth/login
Content-Type: {{json}}

{
  "email": "john.doe@example.com",
  "password": "WrongPassword!"
}

###

### 5. Test Country with JWT Token
GET {{HotelListing.Api_HostAddress}}/api/countries
Accept: {{json}}
Authorization: {{jwtToken}}

###


###############################################
# API KEY AUTHENTICATION ENDPOINTS (/api/apikey)
###############################################

### 1. Test API Key Auth (Success)
GET {{HotelListing.Api_HostAddress}}/api/apikey
Accept: {{json}}
X-Api-Key: {{apiKey}}

###

### 2. Test API Key Secret Endpoint (Success)
GET {{HotelListing.Api_HostAddress}}/api/apikey/secret
Accept: {{json}}
X-Api-Key: {{apiKey}}

###

### 3. Test API Key Auth (Failure - Invalid Key)
GET {{HotelListing.Api_HostAddress}}/api/apikey
Accept: {{json}}
X-Api-Key: InvalidApiKey12345

###


###############################################
# BASIC AUTHENTICATION ENDPOINTS (/api/basicauth)
###############################################

@basicAuthHeader = Basic am9obi5kb2VAZXhhbXBsZS5jb206UGFzc3dvcmQxMjMh

### 1. Test Basic Auth (Success - john.doe@example.com:Password123!)
GET {{HotelListing.Api_HostAddress}}/api/basicauth
Accept: {{json}}
Authorization: {{basicAuthHeader}}

###

### 2. Test Basic Auth Profile (Success)
GET {{HotelListing.Api_HostAddress}}/api/basicauth/profile
Accept: {{json}}
Authorization: {{basicAuthHeader}}

###

### 3. Test Basic Auth (Failure - Invalid Credentials)
GET {{HotelListing.Api_HostAddress}}/api/basicauth
Accept: {{json}}
Authorization: Basic d3Jvbmc6Y3JlZGVudGlhbHM=

###

###############################################
# HOTEL BOOKINGS ENDPOINTS (/api/hotels/{hotelId}/bookings)
###############################################

### 1. Create a New Booking for Hotel (Requires JWT Token)
POST {{HotelListing.Api_HostAddress}}/api/hotels/5/bookings
Content-Type: {{json}}
Authorization: {{jwtToken}}

{
  "checkIn": "2026-09-12",
  "checkOut": "2026-09-15",
  "guests": 2
}

###

### 2. Get All Bookings for Hotel
GET {{HotelListing.Api_HostAddress}}/api/hotels/5/bookings
Accept: {{json}}

###

### 3. Get Specific Booking by ID for Hotel
GET {{HotelListing.Api_HostAddress}}/api/hotels/5/bookings/1
Accept: {{json}}

###


###############################################
# BUILT-IN IDENTITY ENDPOINTS (/api/default-auth)
###############################################

@bearerToken = YOUR_ACCESS_TOKEN_HERE

### 1. Default Register
POST {{HotelListing.Api_HostAddress}}/api/default-auth/register
Content-Type: {{json}}

{
  "email": "defaultuser@example.com",
  "password": "Password123!"
}

###

### 2. Default Login (Get Bearer & Refresh Token)
POST {{HotelListing.Api_HostAddress}}/api/default-auth/login?useCookies=false
Content-Type: {{json}}

{
  "email": "defaultuser@example.com",
  "password": "Password123!"
}

###

### 3. Default Refresh Token
POST {{HotelListing.Api_HostAddress}}/api/default-auth/refresh
Content-Type: {{json}}

{
  "refreshToken": "YOUR_REFRESH_TOKEN_HERE"
}

###

### 4. Default Get User Profile Info (Requires Auth)
GET {{HotelListing.Api_HostAddress}}/api/default-auth/manage/info
Accept: {{json}}
Authorization: Bearer {{bearerToken}}

###

### 5. Default Update User Email / Password (Requires Auth)
POST {{HotelListing.Api_HostAddress}}/api/default-auth/manage/info
Content-Type: {{json}}
Authorization: Bearer {{bearerToken}}

{
  "newEmail": "newuser@example.com",
  "newPassword": "NewPassword123!",
  "oldPassword": "Password123!"
}

###

### 6. Default Forgot Password
POST {{HotelListing.Api_HostAddress}}/api/default-auth/forgotPassword
Content-Type: {{json}}

{
  "email": "defaultuser@example.com"
}

###

### 7. Default Resend Confirmation Email
POST {{HotelListing.Api_HostAddress}}/api/default-auth/resendConfirmationEmail
Content-Type: {{json}}

{
  "email": "defaultuser@example.com"
}

###
