@HotelListing.Api_HostAddress = http://localhost:5268

###############################################
# COUNTRIES ENDPOINTS
###############################################

### 1. Get All Countries
GET {{HotelListing.Api_HostAddress}}/api/countries
Accept: application/json

###

### 2. Get Country By ID
GET {{HotelListing.Api_HostAddress}}/api/countries/1
Accept: application/json

###

### 3. Create New Country
POST {{HotelListing.Api_HostAddress}}/api/countries
Content-Type: application/json

{
  "name": "Bahamas",
  "shortName": "BS"
}

###

### 4. Update Country
PUT {{HotelListing.Api_HostAddress}}/api/countries/1
Content-Type: application/json

{
  "countryId": 1,
  "name": "Jamaica",
  "shortName": "JM"
}

###

### 5. Delete Country By ID
DELETE {{HotelListing.Api_HostAddress}}/api/countries/1

###


###############################################
# HOTELS ENDPOINTS
###############################################

### 1. Get All Hotels
GET {{HotelListing.Api_HostAddress}}/api/hotels
Accept: application/json

###

### 2. Get Hotel By ID
GET {{HotelListing.Api_HostAddress}}/api/hotels/1
Accept: application/json

###

### 3. Create New Hotel (Linked to CountryId: 1)
POST {{HotelListing.Api_HostAddress}}/api/hotels
Content-Type: application/json

{
  "name": "Grand Palladium Resort",
  "address": "Lucea, Hanover",
  "rating": 4.6,
  "countryId": 1
}

###

### 4. Update Hotel
PUT {{HotelListing.Api_HostAddress}}/api/hotels/1
Content-Type: application/json

{
  "id": 1,
  "name": "Grand Palladium Lady Hamilton Resort & Spa",
  "address": "Lucea, Hanover, Jamaica",
  "rating": 4.8,
  "countryId": 1
}

###

### 5. Delete Hotel By ID
DELETE {{HotelListing.Api_HostAddress}}/api/hotels/1

###
